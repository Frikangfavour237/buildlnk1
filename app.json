{
  "expo": {
    "name": "buildIn",
    "slug": "chef-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "buildin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.kemachi.buildin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "firebaseApiKey": "AIzaSyAXhbjtMCxeS9eMZeoTfSVf6vH9OH7l3FU",
      "firebaseAuthDomain": "buildin-1dd4d.firebaseapp.com",
      "firebaseProjectId": "buildin-1dd4d",
      "firebaseStorageBucket": "buildin-1dd4d.firebasestorage.app",
      "firebaseMessagingSenderId": "155039505258",
      "firebaseAppId": "1:155039505258:web:68daa7581c11bb28a16313",
      "eas": {
        "projectId": "15a85a5e-2c3c-4732-a306-4ab50f9eea77"
      }
    }
  }
}
